# Copy to `.env` (or `.env.local`) and point each service at its deployment.
# Only VITE_-prefixed variables reach the browser, so never put secrets here.
#
# Values are base URLs without a trailing slash. Which paths each service owns
# (from FIGMA_FRONTEND_API_SPEC.md) is noted above it; the full endpoint map is
# in src/api/endpoints.ts.

# /auth/*, /users/me/addresses/*
VITE_AUTH_API_URL=http://localhost:8080

# Seller service (no storefront endpoints yet)
VITE_SELLER_API_URL=http://localhost:8081

# /catalogue/*, /admin/catalogue/*
VITE_CATALOGUE_API_URL=http://localhost:8082

# /cart, /cart/items/*, /cart/coupon
VITE_CART_API_URL=http://localhost:8083

# /orders/*, /orders/products/{id}/frequently-bought-together
VITE_ORDER_API_URL=http://localhost:8084

# Shipment service (tracking contract still pending backend clarification)
VITE_SHIPMENT_API_URL=http://localhost:8086

# /notifications/*
VITE_NOTIFICATION_API_URL=http://localhost:8087

# /wishlist/* — the spec doesn't say which service owns these; confirm with the
# backend. Defaults to the catalogue service.
VITE_WISHLIST_API_URL=http://localhost:8082

# The browser calls the URLs above directly, so each backend must allow CORS from
# this site's origin (e.g. http://localhost:5173), including the
# ngrok-skip-browser-warning header for ngrok URLs. Set to true to route calls
# through the Vite dev server instead (npm run dev only; no CORS needed).
VITE_DEV_PROXY=false

# Features that use dummy APIs instead of the services above (comma-separated).
# auth: sign-in accepts any email/password (password "wrong" returns 401), and
#   the profile, photo and password change are stored in the browser.
# notifications: notification preferences are stored in the browser.
# Remove a name to call the real service for it. The product page always uses
# dummy data until GET /catalogue/products/{slug} returns prices and sellers,
# and the cart and wishlist are kept in the browser (Zustand) for now.
VITE_MOCK_APIS=auth,notifications
